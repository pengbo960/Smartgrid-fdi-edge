<mxfile host="app.diagrams.net"><diagram name="System Architecture"><mxGraphModel page="1" pageWidth="1800" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Lightweight Multi-View and Drift-Aware Edge Framework for FDI Detection" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#203040;" vertex="1" parent="1"><mxGeometry x="160" y="20" width="1480" height="50" as="geometry"/></mxCell><mxCell id="a" value="1. IoT Device and Attack Simulation" style="swimlane;rounded=1;startSize=40;fillColor=#D6EAF8;swimlaneFillColor=#F7FBFE;strokeColor=#5B9BD5;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="290" height="690" as="geometry"/></mxCell><mxCell id="a1" value="Smart Meter 01&#xa;Normal contextual device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B9BD5;fontSize=13;shadow=1;" vertex="1" parent="a"><mxGeometry x="30" y="65" width="230" height="65" as="geometry"/></mxCell><mxCell id="a2" value="Smart Meter 02&#xa;Target device / attack injection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;shadow=1;" vertex="1" parent="a"><mxGeometry x="30" y="150" width="230" height="65" as="geometry"/></mxCell><mxCell id="a3" value="Smart Meter 03&#xa;Normal contextual device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B9BD5;fontSize=13;shadow=1;" vertex="1" parent="a"><mxGeometry x="30" y="235" width="230" height="65" as="geometry"/></mxCell><mxCell id="a4" value="Correlated IoT measurements&#xa;Voltage • Current • Power • Frequency&#xa;Periodic signal + phase + noise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#7EA6C9;fontSize=12;" vertex="1" parent="a"><mxGeometry x="30" y="330" width="230" height="82" as="geometry"/></mxCell><mxCell id="a5" value="Reproducible scenarios&#xa;Known: constant, random, replay, topic spoof&#xa;Unseen: gradual manipulation&#xa;Drift: measurement / communication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontSize=12;" vertex="1" parent="a"><mxGeometry x="30" y="440" width="230" height="115" as="geometry"/></mxCell><mxCell id="a6" value="Ground-truth metadata&#xa;scenario • attack • drift • sequence • timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=12;" vertex="1" parent="a"><mxGeometry x="30" y="585" width="230" height="70" as="geometry"/></mxCell><mxCell id="b" value="2. MQTT Communication Layer" style="swimlane;rounded=1;startSize=40;fillColor=#E4DFEC;swimlaneFillColor=#FCFAFE;strokeColor=#8064A2;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="345" y="100" width="250" height="690" as="geometry"/></mxCell><mxCell id="b1" value="MQTT Publisher&#xa;JSON payload per device cycle&#xa;QoS 0 • retain=false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8064A2;fontSize=13;shadow=1;" vertex="1" parent="b"><mxGeometry x="25" y="85" width="200" height="85" as="geometry"/></mxCell><mxCell id="b2" value="Mosquitto MQTT Broker&#xa;grid/substation_01/&#xa;{device_id}/measurement" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#548235;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="b"><mxGeometry x="20" y="235" width="210" height="115" as="geometry"/></mxCell><mxCell id="b3" value="Gateway-visible communication context&#xa;Client ID • Topic • QoS • Retain&#xa;Payload size • Arrival time • Ordering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECF7;strokeColor=#8064A2;fontSize=12;" vertex="1" parent="b"><mxGeometry x="25" y="420" width="200" height="105" as="geometry"/></mxCell><mxCell id="b4" value="Private LAN testbed&#xa;Matched interval: 0.5 s&#xa;Nominal input: 6 messages/s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F8C8D;fontSize=12;" vertex="1" parent="b"><mxGeometry x="25" y="565" width="200" height="82" as="geometry"/></mxCell><mxCell id="c" value="3. Edge Detection Framework — identical code and artifacts on both platforms" style="swimlane;rounded=1;startSize=40;fillColor=#DDEBF7;swimlaneFillColor=#F9FCFF;strokeColor=#2F75B5;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="660" height="690" as="geometry"/></mxCell><mxCell id="c1" value="MQTT Subscriber and Message Parser&#xa;Wildcard subscription • payload validation • gateway timestamp • per-device state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F75B5;fontSize=13;shadow=1;" vertex="1" parent="c"><mxGeometry x="35" y="60" width="590" height="62" as="geometry"/></mxCell><mxCell id="c2" value="Streaming Multi-View Feature Pipeline — causal per-device sliding windows (48 features)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=8;fillColor=#F3FAF7;strokeColor=#46A080;dashed=1;fontSize=13;fontStyle=1;" vertex="1" parent="c"><mxGeometry x="35" y="145" width="590" height="175" as="geometry"/></mxCell><mxCell id="v" value="Value View&#xa;Current values&#xa;Difference / rate&#xa;Rolling statistics&#xa;Measurement consistency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#27AE60;fontSize=11;" vertex="1" parent="c2"><mxGeometry x="18" y="50" width="172" height="102" as="geometry"/></mxCell><mxCell id="t" value="Temporal View&#xa;Inter-arrival interval&#xa;Sequence gaps / replay&#xa;Duplicate / out-of-order&#xa;Repeated-value runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="c2"><mxGeometry x="208" y="50" width="172" height="102" as="geometry"/></mxCell><mxCell id="p" value="Protocol View&#xa;Client–topic identity&#xa;QoS / retain flags&#xa;Payload size&#xa;Unexpected topic relation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#8E44AD;fontSize=11;" vertex="1" parent="c2"><mxGeometry x="398" y="50" width="172" height="102" as="geometry"/></mxCell><mxCell id="c3" value="Known-Attack Classifier&#xa;Standardisation + Logistic Regression&#xa;none • constant • random • replay • topic_spoof" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontSize=12;shadow=1;" vertex="1" parent="c"><mxGeometry x="35" y="345" width="275" height="88" as="geometry"/></mxCell><mxCell id="c4" value="Open-Set Anomaly Scoring&#xa;Isolation Forest fitted to normal behaviour&#xa;confidence + anomaly thresholds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;strokeWidth=2;fontSize=12;shadow=1;" vertex="1" parent="c"><mxGeometry x="350" y="345" width="275" height="88" as="geometry"/></mxCell><mxCell id="c5" value="Decision Engine&#xa;Normal • Known FDI Attack • Unknown Anomaly • Uncertain" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="c"><mxGeometry x="145" y="465" width="370" height="80" as="geometry"/></mxCell><mxCell id="c6" value="Drift Monitor and Guarded Adaptation&#xa;distribution monitoring • bounded approval&#xa;confidence/anomaly/integrity gates • rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=11;" vertex="1" parent="c"><mxGeometry x="35" y="580" width="315" height="75" as="geometry"/></mxCell><mxCell id="c7" value="Alerts and Audit Log&#xa;decision • confidence • anomaly score&#xa;latency • drift/adaptation status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F8C8D;fontSize=11;" vertex="1" parent="c"><mxGeometry x="380" y="580" width="245" height="75" as="geometry"/></mxCell><mxCell id="d" value="4. Cross-Platform Deployment and Evaluation" style="swimlane;rounded=1;startSize=40;fillColor=#E2F0D9;swimlaneFillColor=#FAFDF8;strokeColor=#70AD47;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1305" y="100" width="460" height="690" as="geometry"/></mxCell><mxCell id="d1" value="Fixed deployment bundle&#xa;Classifier • scaler • Isolation Forest&#xa;feature schema • thresholds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#70AD47;fontSize=12;" vertex="1" parent="d"><mxGeometry x="55" y="65" width="350" height="75" as="geometry"/></mxCell><mxCell id="d2" value="MacBook Edge Gateway&#xa;Apple Silicon • emulated edge&#xa;development baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;strokeWidth=2;fontSize=12;shadow=1;" vertex="1" parent="d"><mxGeometry x="35" y="185" width="185" height="98" as="geometry"/></mxCell><mxCell id="d3" value="Raspberry Pi 5 Model B&#xa;Cortex-A76 • 8 GB RAM&#xa;real MQTT edge deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;strokeWidth=2;fontSize=12;shadow=1;" vertex="1" parent="d"><mxGeometry x="240" y="185" width="185" height="98" as="geometry"/></mxCell><mxCell id="d4" value="Resource and Performance Monitor&#xa;Mean / P95 latency • throughput&#xa;CPU utilisation • peak memory&#xa;Pi temperature • throttling state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;" vertex="1" parent="d"><mxGeometry x="55" y="335" width="350" height="108" as="geometry"/></mxCell><mxCell id="d5" value="Prediction parity validation&#xa;1,674 / 1,674 identical decisions&#xa;Fingerprint match: 100%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#27AE60;strokeWidth=2;fontSize=12;" vertex="1" parent="d"><mxGeometry x="55" y="475" width="350" height="82" as="geometry"/></mxCell><mxCell id="d6" value="Evaluation outputs&#xa;Precision • Recall • Macro-F1 • FPR&#xa;Unknown recall • Drift delay&#xa;Cross-platform deployment cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#8E44AD;strokeWidth=2;fontSize=12;" verte